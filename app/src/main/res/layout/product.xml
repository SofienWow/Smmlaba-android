<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="?attr/actionBarSize"
    android:layout_marginBottom="5dp">
    <TextView
        android:textSize="15dp"
        android:textColor="@color/bottom_icon"
        android:gravity="center_horizontal"
        android:id="@+id/name_product"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:gravity="center_horizontal"
                        android:id="@+id/pr"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:src="@drawable/comm"/>
                    <Button
                        android:textColor="@color/button_text"
                        android:id="@+id/sendCart"
                        android:background="@color/button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/order"/>
                    <ImageButton
                        android:id="@+id/favorite"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/star_off"
                        android:scaleType="fitStart"/>
                    <TextView
                        android:textStyle="bold"
                        android:textColor="@color/bottom_icon"
                        android:gravity="center_horizontal"
                        android:id="@+id/lowerprice"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"/>
                    <TextView
                        android:textSize="25sp"
                        android:id="@+id/price"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="@string/default_total"/>
                    <TextView
                        android:textSize="25sp"
                        android:id="@+id/price_balance"
                        android:visibility="gone"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="@string/default_total_balance"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"/>
            </LinearLayout>
            <TextView
                android:textColor="@color/bottom_icon"
                android:gravity="fill_horizontal"
                android:autoLink="web"
                android:id="@+id/description"
                android:background="@color/background"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="60dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
