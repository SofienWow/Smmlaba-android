<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <HorizontalScrollView
        android:id="@+id/scroll_for_screen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/actionBarSize">
        <LinearLayout
            android:theme="@style/Header_bar"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/bottom_icon"
                android:id="@+id/orders"
                android:layout_width="wrap_content"
                android:layout_height="23dp"
                android:layout_marginLeft="10dp"
                android:text="@string/history_order"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/bottom_icon"
                android:id="@+id/balance"
                android:layout_width="wrap_content"
                android:layout_height="23dp"
                android:layout_marginLeft="10dp"
                android:text="@string/history_money"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/bottom_icon"
                android:id="@+id/support"
                android:layout_width="wrap_content"
                android:layout_height="23dp"
                android:layout_marginLeft="10dp"
                android:text="@string/support"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/bottom_icon"
                android:id="@+id/change"
                android:layout_width="wrap_content"
                android:layout_height="23dp"
                android:layout_marginLeft="10dp"
                android:text="@string/change"/>
        </LinearLayout>
    </HorizontalScrollView>
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableLayout
            android:gravity="center"
            android:id="@+id/tableLayout"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"/>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/izminit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="20dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="@string/login"/>
            <EditText
                android:textColor="@color/bottom_icon"
                android:id="@+id/email"
                android:background="@drawable/edit_style"
                android:padding="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="75dp"
                android:ems="10"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/approve_pass"/>
            <EditText
                android:textColor="@color/bottom_icon"
                android:id="@+id/name"
                android:background="@drawable/edit_style"
                android:padding="5dp"
                android:layout_width="226dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:ems="10"
                android:layout_weight="1"
                android:layout_marginStart="85dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/new_pass"/>
            <EditText
                android:textColor="@color/bottom_icon"
                android:id="@+id/pass"
                android:background="@drawable/edit_style"
                android:padding="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:ems="10"
                android:layout_weight="1"
                android:inputType="textPassword"/>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/fors"/>
        <Button
            android:textColor="@color/product_items"
            android:layout_gravity="center"
            android:id="@+id/save"
            android:background="@color/button"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/save"/>
    </LinearLayout>
</LinearLayout>
